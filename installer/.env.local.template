# Copy this file to `.env.local` and fill in the blanks before running
# setup-local.ps1 (or docker compose directly) — see README.md.
# `.env.local` itself is gitignored; never commit real secrets in it.

# A strong random password for the local Postgres instance this installation
# creates — pick your own, don't reuse another tenant's.
POSTGRES_PASSWORD=

# Database/user names — fine to leave at the defaults.
POSTGRES_DB=purch
POSTGRES_USER=purch

# Signs this installation's JWTs — must be a long random string, unique per
# installation, and must never change once staff devices are paired (they'd
# all need to log in again). Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# The LAN port POS devices will reach this server on
# (http://<this-machine's-LAN-IP>:<PURCH_PORT>). 8080 works for most stores;
# change it only if something else on this machine already uses it.
PURCH_PORT=8080

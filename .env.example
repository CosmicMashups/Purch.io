# Deployment mode: Cloud | Local. Set directly per installation, never customer-configurable.
PURCH_DEPLOYMENT_MODE=Cloud

# --- Cloud mode (Supabase) ---
SUPABASE_DB_CONNECTION_STRING=
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_KEY=

# Supabase Auth checks passwords in Cloud mode (Local mode keeps its own credential table).
SUPABASE_AUTH_URL=
SUPABASE_AUTH_SERVICE_KEY=
SUPABASE_AUTH_ANON_KEY=

# --- Local mode (on-prem) ---
LOCAL_DB_CONNECTION_STRING=
LOCAL_STORAGE_PATH=

# --- Auth ---
# Required, no default: any long random string (32+ characters).
JWT_SIGNING_KEY=
JWT_ISSUER=

# --- Payments (Xendit, QR Ph acquiring only) ---
XENDIT_API_KEY=
XENDIT_WEBHOOK_SECRET=

# --- Bill payment / e-load provider (TBD, see docs/adr/0004-bill-payment-provider.md) ---
BILL_PAYMENT_PROVIDER_API_KEY=

# --- Hosting & Web Client Origins ---
RENDER_SERVICE_URL=
# Comma-separated list of allowed origins for the web client (e.g. Cloudflare Pages or custom domains)
CORS_ALLOWED_ORIGINS=https://purch-io-web.pages.dev,http://localhost:5173


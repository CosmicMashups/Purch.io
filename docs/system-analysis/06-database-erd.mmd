        Guid BranchId
        string PinHash
        string Email
        string PasswordHash
        bool IsActive
    }

    ITEM {
        Guid Id PK
        Guid TenantId FK
        Guid CategoryId FK
        string Name
        string Barcode
        decimal BasePrice
        int PricingType
        bool IsActive
        decimal LowStockThreshold
        int TingiMode
        decimal UnitsPerPack
    }


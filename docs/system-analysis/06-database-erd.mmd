    BRANCH {
        Guid Id PK
        Guid TenantId FK
        string Name
        string Address
        string ManualGcashQrImageUrl
    }

    DEVICE {
        Guid Id PK
        Guid TenantId FK
        Guid BranchId FK
        string PairingCode
        string PairingPinHash
        int DeviceType
        bool IsActive
    }

    USER {
        Guid Id PK
        Guid TenantId FK
        string Name
        int Role
        int ScopeType

{
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ],
  "crons": [
    {
      "path": "/internal/retention-sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
